    {
      "type": "text",
      "id": "t_protocol_toolregistry",
      "x": 85,
      "y": 155,
      "width": 290,
      "height": 90,
      "text": "protocol ToolRegistry {\n  register(ToolEntry)\n  lookup(name) -> ToolEntry?\n  allTools -> [ToolEntry]\n  buildToolSchemas() -> [[String:Any]]\n}",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "protocol_toolregistry",
      "originalText": "protocol ToolRegistry {\n  register(ToolEntry)\n  lookup(name) -> ToolEntry?\n  allTools -> [ToolEntry]\n  buildToolSchemas() -> [[String:Any]]\n}",
      "autoResize": true
    },

    {
      "type": "rectangle",
      "id": "type_toolentry",
      "x": 440,
      "y": 150,
      "width": 280,
      "height": 130,
      "backgroundColor": "#fff3bf",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "boundElements": [{ "id": "t_type_toolentry", "type": "text" }]
    },
    {
      "type": "text",
      "id": "t_type_toolentry",
      "x": 445,
      "y": 155,
      "width": 270,
      "height": 120,
      "text": "struct ToolEntry {\n  name: String\n  toolset: String\n  description: String\n  schema: JSONSchema\n  handler: ToolHandler\n  checkFn: ToolRequirementCheck?\n  requiresEnv: [String]\n  emoji: String?\n}",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "type_toolentry",
      "originalText": "struct ToolEntry {\n  name: String\n  toolset: String\n  description: String\n  schema: JSONSchema\n  handler: ToolHandler\n  checkFn: ToolRequirementCheck?\n  requiresEnv: [String]\n  emoji: String?\n}",
      "autoResize": true
    },

    {
      "type": "rectangle",
      "id": "type_jsonschema",
      "x": 780,
      "y": 150,
      "width": 260,
      "height": 160,
      "backgroundColor": "#fff3bf",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "boundElements": [{ "id": "t_type_jsonschema", "type": "text" }]
    },
    {
      "type": "text",
      "id": "t_type_jsonschema",
      "x": 785,
      "y": 155,
      "width": 250,
      "height": 150,
      "text": "enum JSONSchema {\n  string(desc, default)\n  integer(desc, default)\n  number(desc, default)\n  boolean(desc, default)\n  object(props, required)\n  array(items)\n  enum(values)\n\n  func asDictionary() -> [String:Any]\n}",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "type_jsonschema",
      "originalText": "enum JSONSchema {\n  string(desc, default)\n  integer(desc, default)\n  number(desc, default)\n  boolean(desc, default)\n  object(props, required)\n  array(items)\n  enum(values)\n\n  func asDictionary() -> [String:Any]\n}",
      "autoResize": true
    },

    {
      "type": "rectangle",
