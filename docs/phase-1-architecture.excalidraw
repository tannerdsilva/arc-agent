    {
      "type": "text",
      "id": "t_type_aliases",
      "x": 785,
      "y": 335,
      "width": 250,
      "height": 70,
      "text": "typealias ToolHandler\n  = @Sendable ([String:Any]) async throws -> String\n\ntypealias ToolRequirementCheck\n  = @Sendable () -> Bool",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "type_aliases",
      "originalText": "typealias ToolHandler\n  = @Sendable ([String:Any]) async throws -> String\n\ntypealias ToolRequirementCheck\n  = @Sendable () -> Bool",
      "autoResize": true
    },

