    {
      "type": "text",
      "id": "t_concrete_registry",
      "x": 85,
      "y": 435,
      "width": 290,
      "height": 90,
      "text": "struct CompileTimeToolRegistry: ToolRegistry {\n  private var tools: [String: ToolEntry]\n  // Dictionary-backed, insertion-ordered\n  // Duplicate detection on register()\n}",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "concrete_registry",
      "originalText": "struct CompileTimeToolRegistry: ToolRegistry {\n  private var tools: [String: ToolEntry]\n  // Dictionary-backed, insertion-ordered\n  // Duplicate detection on register()\n}",
      "autoResize": true
    },

