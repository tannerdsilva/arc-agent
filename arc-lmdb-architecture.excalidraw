      "fontFamily": 1,
      "strokeColor": "#757575",
      "textAlign": "center",
      "verticalAlign": "middle",
      "originalText": "Each .mdb file is a separate LMDB Environment. Named databases inside are typed key-value stores.",
      "autoResize": true
    },

