    {
      "type": "text",
      "id": "t_db_messages",
      "x": 65,
      "y": 285,
      "width": 330,
      "height": 60,
      "text": "messages: DupSort<SessionID, MessageHeader>\nKey: SessionID (UUID, 16 bytes)\nValue: role + timestamp + body_len + body_offset\nDup: multiple messages per session, ordered by insertion",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "db_messages",
      "originalText": "messages: DupSort<SessionID, MessageHeader>\nKey: SessionID (UUID, 16 bytes)\nValue: role + timestamp + body_len + body_offset\nDup: multiple messages per session, ordered by insertion",
      "autoResize": true
    },

