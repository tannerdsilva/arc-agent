    {
      "type": "text",
      "id": "t_composite2",
      "x": 105,
      "y": 885,
      "width": 490,
      "height": 60,
      "text": "KanbanStatusKey = StatusByte (1 byte) + Priority (4 bytes, big-endian) + TaskID (16 bytes)\nOrder: triage first, then by priority within status, then by TaskID for uniqueness",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "composite2",
      "originalText": "KanbanStatusKey = StatusByte (1 byte) + Priority (4 bytes, big-endian) + TaskID (16 bytes)\nOrder: triage first, then by priority within status, then by TaskID for uniqueness",
      "autoResize": true
    },

