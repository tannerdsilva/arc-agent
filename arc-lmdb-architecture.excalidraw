      "x": 65,
      "y": 195,
      "width": 330,
      "height": 60,
      "text": "sessions: Strict<SessionID, SessionMeta>\nKey: UUID (16 bytes, big-endian)\nValue: created_at + updated_at + model + provider + msg_count",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "db_sessions",
      "originalText": "sessions: Strict<SessionID, SessionMeta>\nKey: UUID (16 bytes, big-endian)\nValue: created_at + updated_at + model + provider + msg_count",
      "autoResize": true
    },

    {
      "type": "rectangle",
      "id": "db_messages",
      "x": 60,
      "y": 280,
      "width": 340,
      "height": 70,
