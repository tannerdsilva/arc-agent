    {
      "type": "text",
      "id": "t_composite1",
      "x": 105,
      "y": 795,
      "width": 490,
      "height": 60,
      "text": "SessionMessageID = SessionID (16 bytes) + SequenceNumber (8 bytes, big-endian)\nOrder: all messages for a session are contiguous in B-tree order",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "composite1",
      "originalText": "SessionMessageID = SessionID (16 bytes) + SequenceNumber (8 bytes, big-endian)\nOrder: all messages for a session are contiguous in B-tree order",
      "autoResize": true
    },

    {
      "type": "rectangle",
      "id": "composite2",
      "x": 100,
      "y": 880,
      "width": 500,
      "height": 70,
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "roundness": { "type": 3 },
      "boundElements": [{ "id": "t_composite2", "type": "text" }]
